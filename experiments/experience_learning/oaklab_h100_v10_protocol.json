  "claim_ceiling": "LocalDevelopmentOakLabH100ReplicationV10ProtocolOnly",
  "estimand": {
    "name": "segment-bounded cost-adjusted predictive utility",
    "unit": "episode segment",
    "control": "fixed_sgd_b1",
    "treatment": "dual_budgeted_credit",
    "primary_endpoint": "mean_e_mean_b((-loss_treatment[e,b]-0.001*ops_treatment[e,b]-0.05*storage_treatment[e,b]/dimension)-(-loss_control[e,b]-0.001*ops_control[e,b]-0.05*storage_control[e,b]/dimension))",
    "favorable_direction": "positive",
    "segment_rows": 32,
    "trajectory_rows": 256,
    "warmup_segments": 1,
    "post_washout_segments": 7,
    "same_stream": true,
    "same_initial_checkpoint": true,
    "arm_order_randomized": true,
    "trajectory": "complete learner and controller state",
    "carryover_control": "previous completed segment only; no current outcome, target, or counter enters action selection; controller resets at trajectory start",
    "loss_timing": "half_squared_error_before_row_action",
    "assessment_absent_until_lock": true,
    "utility_formula": "-segment_loss-0.001*segment_active_ops-0.05*segment_storage_bytes/dimension",
    "resource_targets": {"active_ops_per_row": 48, "storage_bytes_per_parameter": 8}
  },
  "controller": {
    "name": "dual-budgeted segment credit controller",
    "decision_boundary": "segment boundary only",
    "action_rule": "apply next segment iff prior_segment_utility_ema >= 0 and prior_segment_ops <= ops_budget and prior_segment_storage <= storage_budget; exact equality applies",
    "state_fields": [
      ["utility_ema", "float64", "trajectory"],
      ["ops_ema", "float64", "trajectory"],
      ["storage_ema", "float64", "trajectory"],
      ["policy_bit", "uint8", "trajectory"],
      ["previous_segment_loss", "float64", "pending"],
      ["previous_segment_ops", "uint64", "pending"],
      ["previous_segment_storage", "uint64", "pending"],
      ["previous_segment_id", "uint32", "trajectory"],
      ["rows_in_segment", "uint8", "trajectory"],
      ["processed_rows", "uint32", "trajectory"]
    ],
    "state_bytes": 62,
    "recurrence": [
      "utility_ema_new=0.875*utility_ema+0.125*(-previous_segment_loss)",
      "ops_ema_new=0.875*ops_ema+0.125*previous_segment_ops",
      "storage_ema_new=0.875*storage_ema+0.125*previous_segment_storage",
      "policy_bit_new=1 iff utility_ema_new>=0 and ops_ema_new<=ops_budget and storage_ema_new<=storage_budget"
    ],
    "transition_table": [
      {"index": 0, "event": "trajectory_init", "reads": [], "writes": ["utility_ema", "ops_ema", "storage_ema", "policy_bit", "previous_segment_loss", "previous_segment_ops", "previous_segment_storage", "previous_segment_id", "rows_in_segment", "processed_rows"], "rule": "reset every state field and set policy_bit=1"},
      {"index": 1, "event": "observe_pre_action", "reads": ["features", "target", "policy_bit", "processed_rows"], "writes": ["counter_row"], "rule": "score loss before any row action"},
      {"index": 2, "event": "row_action", "reads": ["features", "target", "policy_bit"], "writes": ["model_parameters", "processed_rows", "rows_in_segment", "counter_row"], "rule": "one SGD row update iff policy_bit=1; no accumulation or replay"},
      {"index": 3, "event": "segment_finalize", "reads": ["rows_in_segment", "counter_row"], "writes": ["previous_segment_loss", "previous_segment_ops", "previous_segment_storage", "previous_segment_id"], "rule": "publish exactly one complete segment summary"},
      {"index": 4, "event": "segment_credit", "reads": ["previous_segment_loss", "previous_segment_ops", "previous_segment_storage", "utility_ema", "ops_ema", "storage_ema"], "writes": ["utility_ema", "ops_ema", "storage_ema", "policy_bit"], "rule": "all right-hand sides use the pre-boundary snapshot; current segment is unread"},
      {"index": 5, "event": "segment_select", "reads": ["policy_bit", "previous_segment_id"], "writes": ["policy_bit", "rows_in_segment"], "rule": "hold one policy bit for exactly 32 rows"},
      {"index": 6, "event": "trajectory_finalize", "reads": ["previous_segment_id", "processed_rows"], "writes": [], "rule": "finalize counters only; no model action"}
    ],
    "budgets": {"ops_budget": 48, "storage_budget": 8}
  },
  "generator_roster": {
