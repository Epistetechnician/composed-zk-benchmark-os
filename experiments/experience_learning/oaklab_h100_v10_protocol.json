      "event_sensor_v10": {"family": "event", "dimension": 64, "equation": "three deduplicated signed events; x0 parity anchor; target sign flips at row 128", "segments": [0, 128, 256], "oracle_features": [0]},
      "long_horizon_v10": {"family": "long_horizon", "dimension": 8, "equation": "ring_buffer(x0,row-32); zero prefill; target sign flips at row 128", "segments": [0, 128, 256], "oracle_features": [0]},
      "pure_noise_v10": {"family": "null", "dimension": 16, "equation": "xi=(activity_i<0.15)*polarity_i; y=z independent of x", "segments": [0, 256], "oracle_features": []}
