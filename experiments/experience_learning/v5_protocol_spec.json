      {"name":"previous_action", "type":"uint8", "lifetime":"trajectory", "initial":"255 means none"},
      {"name":"previous_features", "type":"float64[6]", "lifetime":"trajectory", "initial":"zeros"},
      {"name":"previous_q", "type":"float64", "lifetime":"trajectory", "initial":"0"},
      {"name":"previous_apply_cost", "type":"float64", "lifetime":"trajectory", "initial":"0"},
      {"name":"previous_mu_at_action", "type":"float64", "lifetime":"trajectory", "initial":"0"},
      {"name":"pending_features", "type":"float64[6]", "lifetime":"one transition", "initial":"zeros"},
      {"name":"pending_prediction", "type":"float64", "lifetime":"one transition", "initial":"0"},
      {"name":"pending_loss", "type":"float64", "lifetime":"one transition", "initial":"0"},
      {"name":"pending_event_count", "type":"uint32", "lifetime":"one transition", "initial":"0"},
      {"name":"pending_action", "type":"uint8", "lifetime":"one transition", "initial":"255 means none"},
      {"name":"pending_apply_cost", "type":"float64", "lifetime":"one transition", "initial":"0"},
      {"name":"pending_mu_at_action", "type":"float64", "lifetime":"one transition", "initial":"0"},
      {"name":"pending_reward", "type":"float64", "lifetime":"one transition", "initial":"0"},
      {"name":"pending_terminal", "type":"boolean", "lifetime":"one transition", "initial":"false"},
      {"name":"pending_local_row", "type":"uint32", "lifetime":"one transition", "initial":"0"}
    ],
    "constants": {
      "discount_gamma": 0.9,
      "eligibility_lambda": 0.8,
      "controller_alpha": 0.05,
      "dual_alpha": 0.01,
      "dual_max": 2.0,
      "apply_cost": 1.0,
      "action_rate_budget": "min(0.75,max(0,(3*dimension-8)/(3*dimension+3)))"
    },
    "rows": [
      {"index":0,"event":"trajectory_init","reads":[],"writes":["trace","q_old","pending_valid","previous_action","previous_features","previous_q","previous_apply_cost","previous_mu_at_action","pending_terminal","pending_local_row"],"order":"reset trajectory fields before row 0; theta and dual_mu persist only across fit trajectories"},
      {"index":1,"event":"observe_pre_action","reads":["Experience.features","Experience.target","Experience.event_indices"],"writes":["pending_prediction","pending_loss","pending_event_count","pending_features"],"order":"predict then compute finite half-squared loss before any write"},
      {"index":2,"event":"select_action","reads":["pending_features","theta","dual_mu","pending_loss","pending_event_count","hash_transcript"],"writes":["pending_action","pending_apply_cost","pending_mu_at_action"],"order":"compute q_skip and q_apply from pre-update theta; fit uses hash exploration; tune/assessment use locked greedy; ties apply"},
      {"index":4,"event":"model_action","reads":["pending_action","Experience.features","Experience.target"],"writes":["model_parameters","counter_row"],"order":"execute selected action after prior credit; apply performs exactly one fixed-rate SGD update; skip performs no parameter write"},
      {"index":3,"event":"credit_previous_fit_only","reads":["pending_valid","pending_reward","pending_features","previous_features","previous_q","q_old","previous_mu_at_action","previous_apply_cost"],"writes":["theta","trace","q_old","dual_mu","previous_action","previous_features","previous_q","previous_apply_cost","previous_mu_at_action"],"order":"if pending_valid, credit prior action before current model action; reward uses previous_mu_at_action snapshot"},
      {"index":5,"event":"pending_write","reads":["pending_features","pending_prediction","pending_loss","pending_action","pending_apply_cost","pending_mu_at_action","local_row"],"writes":["pending_valid","previous_features","previous_q","previous_action","previous_apply_cost","previous_mu_at_action","pending_local_row"],"order":"publish current action and all fields needed by the next row; no implicit state"},
      {"index":6,"event":"trajectory_end","reads":["pending_valid","pending_local_row","terminal_loss"],"writes":["pending_reward","pending_terminal","theta","trace","q_old","dual_mu","pending_valid"],"order":"row 251 supplies terminal reward for row 250 with q_current=0 and gamma=0; no row-251 model action"},
      {"index":7,"event":"counter_finalize","reads":["counter_row"],"writes":["counter_receipt"],"order":"append one canonical counter row after every observe action"}
    ],
    "controller_recurrence": [
      "delta=reward+gamma*q_current-previous_q",
      "trace=gamma*lambda*trace+previous_features-alpha*gamma*lambda*dot(trace,previous_features)*previous_features",
      "theta=theta+alpha*(delta+previous_q-q_old)*trace-alpha*(previous_q-q_old)*previous_features",
      "q_old=q_current",
      "dual_mu=clip(dual_mu+dual_alpha*(previous_apply_cost-budget),0,dual_max)"
    ],
    "pending_rule": "every pending_* field is either consumed and overwritten within the indexed transition sequence or reset at boundary; undeclared state is invalid",
    "row_251_rule": "for 252 rows, row 251 records pre-update loss and terminal reward for row 250; no model action occurs on row 251"
  },
