  "estimand": {
    "name": "paired complete-policy cumulative pre-update loss effect",
    "notation": "tau_f=E_seed[sum_t loss_t(fixed_sgd_b1)-sum_t loss_t(locked_policy)]",
    "unit": "assessment seed trajectory",
    "loss": "0.5*(prediction-target)^2 measured before the row action",
    "scope": "complete-policy trajectory including carryover from every earlier action",
    "identification": [
      "candidate and reference start from byte-identical zero model states",
      "candidate and reference consume identical ordered rows and one row per observe",
      "assessment actions are deterministic from the locked controller",
      "assessment seeds are independent experimental units",
      "candidate controller state never mutates during tune or assessment"
    ],
    "primary_transform": "D_seed_f=log((candidate_cumulative_loss+1e-12)/(reference_cumulative_loss+1e-12))",
    "favorable_direction": "tau_f>0 and mean(D_seed_f)<0"
  },
  "hash_prng_transcript": {
    "canonical_json": "UTF-8 bytes from json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)",
    "file_bytes": "UTF-8 without BOM, LF line endings, exactly one final LF; source digest is over these exact bytes",
    "source_digest": "SHA-256 of the exact UTF-8 bytes of v5_protocol_spec.json; whitespace changes the digest",
    "digest_encoding": "lowercase hexadecimal with exactly 64 ASCII characters",
    "frame": "LP32(payload)=u32_be(byte_length(payload))||payload for variable UTF-8 fields; fixed digest/uint32/uint64 fields are raw fixed-width bytes with no length prefix; concatenate fields in declared order",
    "field_encodings": {
      "utf8": "UTF-8 payload bytes",
      "uint32": "unsigned 32-bit big-endian payload",
      "uint64": "unsigned 64-bit big-endian payload",
      "hex_digest": "decode exactly 64 lowercase/uppercase hex characters into 32 bytes"
    },
    "protocol_seed_frame": ["domain_tag_utf8", "protocol_digest_raw_32", "cohort_id_utf8", "stream_id_utf8", "data_seed_uint64"],
    "protocol_seed_domain": "oaklab.cup.v5.splitmix64.seed.v1",
    "splitmix64": {
      "state_initialization": "uint64_be(SHA256(protocol_seed_frame)[0:8])",
      "next_uint64": [
        "state=(state+0x9E3779B97F4A7C15) mod 2^64",
        "z=state",
        "z=((z xor (z>>30))*0xBF58476D1CE4E5B9) mod 2^64",
        "z=((z xor (z>>27))*0x94D049BB133111EB) mod 2^64",
        "return z xor (z>>31)"
      ],
      "uniform53": "(next_uint64()>>11)/9007199254740992",
      "rademacher": "-1 if uniform53()<0.5 else +1",
      "normal_approximation": "sum(next_uniform53() for exactly 12 draws)-6",
      "index": "floor(uniform53()*dimension), with 0<=index<dimension"
    },
    "draw_transcript_row": "cohort_id,stream_id,data_seed,row,draw_ordinal,draw_label,raw_uint64,derived_value; every listed draw is consumed even when its value is ignored",
    "action_hash": {
      "domain": "oaklab.cup.v5.action.v1",
      "fields": ["protocol_digest_raw_32", "exploration_master_seed_raw_32", "cohort_id_utf8", "stream_id_utf8", "data_seed_uint64", "local_row_uint32"],
      "probability_encoding": "rational p_num/p_den; threshold=floor(p_num*2^256/p_den), never binary floating comparison",
      "decision": "apply iff uint256_be(SHA256(frame)) < threshold; otherwise skip",
      "ties": "apply"
    },
    "exploration_master_seed_hex": "7fefd5e1fbc346fbe8c20dfba40c7c362a0f6935d6d5f4707291ded5ea87cd56",
    "transcript_test_vector_rule": "compiler emits root initialization state, first 12 raw SplitMix64 outputs, first uniform53, first normal12, and action-hash digest for fit/stream/data_seed/row=(fit,sparse_predictable_v5,4000,0)",
    "transcript_schema": {
      "fields": [
        ["draw_ordinal", "uint32", true],
        ["draw_label", "utf8", true],
        ["raw_uint64", "uint64", true],
        ["derived_value", "float64_or_uint32", true]
      ],
      "ordering": "ascending draw_ordinal; no conditional draws"
    }
  },
  "controller_transition_table": {
    "actions": ["skip", "apply"],
    "features": ["intercept", "loss_context", "event_density", "previous_apply_cost", "segment_phase", "bias_context"],
    "feature_formula": {
      "loss_context": "min(1,max(0,log1p(pre_update_loss)/4))",
      "event_density": "min(1,active_event_count/dimension)",
      "segment_phase": "row/(segment_stop-segment_start-1) clipped to [0,1]",
      "bias_context": "1 if target_sign equals prediction_sign else 0"
    },
    "state_fields": [
