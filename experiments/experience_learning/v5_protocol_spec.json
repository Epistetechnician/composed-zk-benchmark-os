      {"name":"trace", "type":"float64[6]", "lifetime":"trajectory", "initial":"[0,0,0,0,0,0]"},
      {"name":"q_old", "type":"float64", "lifetime":"trajectory", "initial":"0"},
      {"name":"dual_mu", "type":"float64", "lifetime":"fit", "initial":"0"},
