{
  "schema_version": "oaklab.experience-learning.h100-replication-v9.source.v1",
  "protocol_id": "oaklab.h100.v9",
  "state_slice": "oaklab-experience-learning-h100-replication-v9",
  "status": "frozen_pending_independent_review",
  "implementation_before_review": false,
  "claim_ceiling": "LocalDevelopmentOakLabH100ReplicationV9ProtocolOnly",
  "estimand": {
    "name": "paired segment-bounded cost-adjusted utility",
    "unit": "episode segment",
    "control": "fixed_sgd_b1",
    "treatment": "segment_budgeted_update_policy",
    "primary_endpoint": "mean_e_b((loss_treatment-loss_control)+0.002*(ops_treatment-ops_control)+0.05*(storage_treatment-storage_control)/dimension)",
    "favorable_direction": "negative",
    "segment_rows": 32,
    "warmup_segments": 1,
    "post_washout_segments": 7,
    "same_stream": true,
    "same_initial_checkpoint": true,
    "arm_order_randomized": true,
    "trajectory": "complete learner and controller state",
    "carryover_control": "previous segment only; no current segment outcome enters action; controller state resets at trajectory start",
    "loss_timing": "half_squared_error_before_row_action",
    "assessment_absent_until_lock": true
  },
  "controller": {
    "name": "segment-budgeted cost-adjusted utility controller",
    "decision_boundary": "segment boundary only",
    "action_rule": "apply iff utility_ema-0.002*cost_ema >= 0; exact tie applies",
    "utility_definition": "previous_segment_loss-current_segment_loss-0.002*(current_segment_ops-previous_segment_ops)",
    "recurrence": [
      "utility_ema_new=0.80*utility_ema+0.20*observed_previous_segment_utility",
      "cost_ema_new=0.90*cost_ema+0.10*previous_segment_apply_fraction",
      "policy_bit_new=1 if utility_ema_new-0.002*cost_ema_new >= 0 else 0"
    ],
    "simultaneous_rhs": "all right-hand sides read the pre-boundary snapshot and commit simultaneously",
    "states": [
      ["utility_ema", "float64", "trajectory"],
      ["cost_ema", "float64", "trajectory"],
      ["policy_bit", "uint8", "trajectory"],
      ["previous_segment_loss", "float64", "trajectory"],
      ["previous_segment_ops", "uint64", "trajectory"],
      ["previous_segment_id", "uint32", "trajectory"],
      ["pending_valid", "uint8", "trajectory"],
      ["rows_in_segment", "uint8", "trajectory"],
      ["processed_rows", "uint32", "trajectory"]
    ],
    "transition_table": [
      {"index": 0, "event": "trajectory_init", "reads": [], "writes": ["utility_ema", "cost_ema", "policy_bit", "previous_segment_loss", "previous_segment_ops", "previous_segment_id", "pending_valid", "rows_in_segment", "processed_rows"], "rule": "reset all controller fields"},
      {"index": 1, "event": "segment_boundary_credit", "reads": ["pending_valid", "previous_segment_loss", "previous_segment_ops", "utility_ema", "cost_ema", "previous_segment_id"], "writes": ["utility_ema", "cost_ema", "policy_bit"], "rule": "credit only the completed previous segment before selecting the next policy"},
      {"index": 2, "event": "select_segment_policy", "reads": ["policy_bit", "previous_segment_id", "rows_in_segment"], "writes": ["policy_bit", "rows_in_segment"], "rule": "hold one policy bit for exactly 32 rows; no row outcome is read"},
      {"index": 3, "event": "observe_row", "reads": ["features", "target", "policy_bit", "processed_rows"], "writes": ["model_parameters", "processed_rows", "rows_in_segment", "counter_row"], "rule": "apply one SGD row update iff policy_bit is one"},
      {"index": 4, "event": "segment_finalize", "reads": ["rows_in_segment", "processed_rows", "counter_row"], "writes": ["previous_segment_loss", "previous_segment_ops", "previous_segment_id", "pending_valid", "rows_in_segment"], "rule": "publish complete segment counters exactly once"},
      {"index": 5, "event": "trajectory_finalize", "reads": ["pending_valid", "previous_segment_id"], "writes": ["pending_valid"], "rule": "finalize counters; no model action"}
    ],
    "state_bytes": "8+8+1+8+8+4+1+1+4"
  },
  "generator_roster": {
    "stream_order": ["sparse_signal_v9", "drifting_relevance_v9", "delayed_reward_v9", "event_sensor_v9", "long_horizon_v9", "pure_noise_v9"],
    "rows_per_trajectory": 256,
    "segment_boundaries": [0, 32, 64, 96, 128, 160, 192, 224, 256],
    "draw_rule": "every declared draw is consumed once in ordinal order; no conditional draws, redraws, replay, or future-data reads",
    "draw_roster": {
      "sparse_signal_v9": [[0, "signal", "rademacher", 1], [1, "activity", "uniform53", 15], [2, "polarity", "rademacher", 15], [3, "target_noise", "normal12", 1]],
      "drifting_relevance_v9": [[0, "feature_uniform", "uniform53", 8], [1, "target_noise", "normal12", 1]],
      "delayed_reward_v9": [[0, "cue", "rademacher", 1], [1, "unused_cue", "rademacher", 1], [2, "target_noise", "normal12", 1]],
      "event_sensor_v9": [[0, "event_index", "uniform53", 3], [1, "event_polarity", "rademacher", 3], [2, "target_noise", "normal12", 1]],
      "long_horizon_v9": [[0, "feature_uniform", "uniform53", 8], [1, "target_noise", "normal12", 1]],
      "pure_noise_v9": [[0, "activity", "uniform53", 16], [1, "polarity", "rademacher", 16], [2, "target_noise", "normal12", 1]]
    },
    "semantics": {
      "sparse_signal_v9": {"family": "predictable_noise", "dimension": 16, "equation": "x0=signal; xi=(activity_i<0.15)*polarity_i; y=1.5*x0+0.25*z", "segments": [0, 256], "oracle_features": [0]},
      "drifting_relevance_v9": {"family": "drift", "dimension": 8, "equation": "xi=2*uniform_i-1; y=(2*x0 if row<128 else -2*x1)+0.1*z", "segments": [0, 128, 256], "oracle_features": [0, 1]},
      "delayed_reward_v9": {"family": "delayed_reward", "dimension": 4, "equation": "32 eight-row episodes; cue cached at episode start; reward at phase seven; sign flips at episode 16", "segments": [0, 128, 256], "oracle_features": [0]},
      "event_sensor_v9": {"family": "event", "dimension": 64, "equation": "three deduplicated signed events; x0 parity anchor; target sign flips at row 128", "segments": [0, 128, 256], "oracle_features": [0]},
      "long_horizon_v9": {"family": "long_horizon", "dimension": 8, "equation": "ring_buffer(x0,row-32) with target sign flip at row 128; prefill zero", "segments": [0, 128, 256], "oracle_features": [0]},
      "pure_noise_v9": {"family": "null", "dimension": 16, "equation": "xi=(activity_i<0.15)*polarity_i; y=z independent of x", "segments": [0, 256], "oracle_features": []}
    }
  },
  "hash_prng": {
    "canonical_json": "UTF-8 JSON sort_keys=true separators=(',',':') ensure_ascii=true allow_nan=false plus one LF",
    "digest": "SHA-256 lowercase hexadecimal",
    "frame": "LP32 big-endian length plus payload",
    "source_bytes": "UTF-8 without BOM; exact bytes hashed; no post-hash normalization",
    "row_frame": "LP32(domain)+protocol_digest_raw+LP32(cohort)+LP32(stream)+uint64_le(seed)+uint32_le(row)",
