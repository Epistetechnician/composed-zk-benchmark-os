  "blocking_findings": [
    {"id": "V6-CTRL-001", "finding": "Indexed controller rows omit RHS reads: row 2 uses eligibility and theta without declaring them, and terminal row 6 claims final recurrence credit while omitting pending reward, eligibility, theta, q-old, previous features, previous q, previous cost, and dual state. The closed-world state machine is not executable."},
    {"id": "V6-STAT-002", "finding": "With X=-D, candidate benefit is positive X and the favorable one-sided tail is 0.5*erfc(z/sqrt(2)); the frozen p_one=0.5*erfc(-z/sqrt(2)) reverses the gate direction."},
    {"id": "V6-ALG-003", "finding": "counter_row fixes energy_joules as float64 in a 143-byte layout but its schema says float64_or_absent and the resource invariant requires absence before a privileged receipt; no absent encoding is specified."},
    {"id": "V6-ALG-004", "finding": "phase, cohort, arm_id, and lock decision uint8 enum mappings are absent; logical_state_bytes, replay_bytes, and latency_ns lack exact formulas and capture boundaries, so receipts and resource claims are not unique."},
    {"id": "V6-GEN-005", "finding": "event_sensor_v6 does not map row parity to a sign, and delayed_reward_v6 does not declare the initial sign before its episode-16 flip; both permit distinct stream values."},
    {"id": "V6-MET-006", "finding": "Adaptation recovery_scan omits k start/domain/increment, while explicit censored lag values conflict with missing_rules that fail every censored trajectory; adaptation endpoints and gates are not uniquely computable."},
    {"id": "V6-SCHEMA-007", "finding": "fit_lock theta_binary64_hex and dual_mu_binary64_hex types do not freeze hex element widths or byte order, leaving multiple lock encodings for the same state."}
