{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimesFM3 temporal stress-scenario manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_slice", "scenario_manifest_id", "request_id", "forecast_output_digest", "benchmark_binding", "scenario_config", "arms", "claim_boundary", "non_claims", "manifest_digest"],
  "properties": {
    "schema_version": {"const": "timesfm3-temporal-stress-scenarios-scenario-v1"},
    "state_slice": {"const": "timesfm3-temporal-stress-scenarios-v1"},
    "scenario_manifest_id": {"type": "string"},
    "request_id": {"type": "string"},
    "forecast_output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "benchmark_binding": {"type": "object", "additionalProperties": false},
    "scenario_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_metric", "load_plan", "rounding", "max_load", "seed"],
      "properties": {
        "workload_metric": {"enum": ["arrival_rate", "queue_depth", "trace_length", "recursion_depth", "context_size", "memory_pressure", "latency_demand", "workload_volume"]},
        "load_plan": {"const": "deterministic_local_shard_plan_v1"},
        "rounding": {"const": "ceil_nonnegative"},
        "max_load": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "arms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/arm"}
    },
    "claim_boundary": {"const": "LocalDevelopmentTimesFM3TemporalStressScenarioQualificationV1"},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hex_digest", "byte_len"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "hex_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_len": {"type": "integer", "minimum": 0, "maximum": 4194304}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "quantile", "label", "artifact_ref", "fixed_case_ids", "forecast_values", "load_values", "artifact_digest"],
      "properties": {
        "arm": {"enum": ["low", "median", "high"]},
        "quantile": {"enum": [0.1, 0.5, 0.9]},
        "label": {"const": "model_derived_synthetic_input"},
        "artifact_ref": {"type": "string"},
        "fixed_case_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forecast_values": {"type": "array"},
        "load_values": {"type": "array"},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
